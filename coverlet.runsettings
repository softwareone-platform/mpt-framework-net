<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>opencover</Format>
          <Exclude>[xunit.*]*,[*.Tests]*</Exclude>
          <!--
            Public-API interfaces with default-implementation convenience overloads.
            Coverlet otherwise counts the default-method bodies as "to-cover" lines,
            but they're forwarders to the explicit interface members and the concrete
            implementations are exercised via integration tests against the real
            engines. Excluding the contract files keeps coverage focused on logic
            rather than API ergonomics.
          -->
          <ExcludeByFile>**/Mpt.Framework.Persistence.Abstractions/Data/IRepository.cs,**/Mpt.Framework.Persistence.Abstractions/Query/IQueryService.cs,**/Mpt.Framework.Persistence.Abstractions/Rules/IEntityEventProducer.cs,**/Mpt.Framework.Persistence.Abstractions/Rules/IEntityConfiguration.cs,**/Mpt.Framework.Persistence.Abstractions/Rules/Policies/IUpdatePolicy.cs,**/Mpt.Framework.Persistence.Abstractions/Rules/Policies/IUpdatePolicyRuleBuilder.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
