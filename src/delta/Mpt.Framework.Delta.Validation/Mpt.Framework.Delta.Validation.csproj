<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mpt.Framework.Delta.Validation</RootNamespace>
    <AssemblyName>Mpt.Framework.Delta.Validation</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Mpt.Framework.Delta.Validation</PackageId>
    <Title>Mpt.Framework.Delta.Validation</Title>
    <Description>FluentValidation integration for Mpt.Framework.Delta — provides a DeltaValidator&lt;T&gt; base class and rule-builder extensions (MustBeDefined, MustBeOmitted, WhenDefined, ForEachDelta) that produce error paths matching the original JSON structure.</Description>
    <Authors>SoftwareOne and the Mpt.Framework contributors</Authors>
    <Company>SoftwareOne</Company>
    <Copyright>Copyright 2026 SoftwareOne and the Mpt.Framework contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>json;partial;patch;delta;fluentvalidation;validation</PackageTags>
    <PackageProjectUrl>https://github.com/SoftwareONE/mpt-framework-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SoftwareONE/mpt-framework-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" Condition="Exists('README.md')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="[11.0.0,12.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mpt.Framework.Delta\Mpt.Framework.Delta.csproj" />
  </ItemGroup>

</Project>
