<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mpt.Framework.Mapping.EFCore</RootNamespace>
    <AssemblyName>Mpt.Framework.Mapping.EFCore</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Mpt.Framework.Mapping.EFCore</PackageId>
    <Title>Mpt.Framework.Mapping.EFCore</Title>
    <Description>Entity Framework Core flavour of the Mpt.Framework.Mapping dynamic entity mapper. Subclasses DynamicEntityMapper to look up platform-entity references from a DbContext (FK assignment, navigation loading, removal tracking) so that the mapper plays nicely with EF Core change tracking. Reference Mpt.Framework.Mapping.Abstractions from your Application layer.</Description>
    <Authors>SoftwareOne and the Mpt.Framework contributors</Authors>
    <Company>SoftwareOne</Company>
    <Copyright>Copyright 2026 SoftwareOne and the Mpt.Framework contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mapping;entityframeworkcore;efcore;rql;dto;entity</PackageTags>
    <PackageProjectUrl>https://github.com/SoftwareONE/mpt-framework-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SoftwareONE/mpt-framework-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" Condition="Exists('README.md')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[10.0.0,11.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mpt.Framework.Mapping\Mpt.Framework.Mapping.csproj" />
  </ItemGroup>

</Project>
