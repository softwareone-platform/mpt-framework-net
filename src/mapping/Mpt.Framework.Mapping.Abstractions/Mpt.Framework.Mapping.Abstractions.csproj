<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mpt.Framework.Mapping</RootNamespace>
    <AssemblyName>Mpt.Framework.Mapping.Abstractions</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Mpt.Framework.Mapping.Abstractions</PackageId>
    <Title>Mpt.Framework.Mapping.Abstractions</Title>
    <Description>Abstractions for Mpt.Framework.Mapping — the dynamic entity mapper interfaces. Reference this package from your Application layer to define services that consume the dynamic mapper without taking a dependency on RQL; install Mpt.Framework.Mapping in your composition root to wire up the engine.</Description>
    <Authors>SoftwareOne and the Mpt.Framework contributors</Authors>
    <Company>SoftwareOne</Company>
    <Copyright>Copyright 2026 SoftwareOne and the Mpt.Framework contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mapping;abstractions;rql;dto;entity</PackageTags>
    <PackageProjectUrl>https://github.com/SoftwareONE/mpt-framework-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SoftwareONE/mpt-framework-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" Condition="Exists('README.md')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\abstractions\Mpt.Framework.Abstractions\Mpt.Framework.Abstractions.csproj" />
  </ItemGroup>

</Project>
