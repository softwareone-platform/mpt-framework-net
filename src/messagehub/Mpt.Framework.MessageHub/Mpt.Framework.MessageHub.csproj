<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mpt.Framework.MessageHub</RootNamespace>
    <AssemblyName>Mpt.Framework.MessageHub</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Mpt.Framework.MessageHub</PackageId>
    <Title>Mpt.Framework.MessageHub</Title>
    <Description>MassTransit-based event bus for module-to-module pub/sub. Publishers send EventMessage payloads to a topic; consumers subscribe via strongly-typed input streams that declare which events they handle, filtered server-side by SQL rules on Azure Service Bus (or client-side on the in-memory transport).</Description>
    <Authors>SoftwareOne and the Mpt.Framework contributors</Authors>
    <Company>SoftwareOne</Company>
    <Copyright>Copyright 2026 SoftwareOne and the Mpt.Framework contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>messaging;eventbus;masstransit;servicebus;publish;subscribe;pubsub</PackageTags>
    <PackageProjectUrl>https://github.com/SoftwareONE/mpt-framework-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SoftwareONE/mpt-framework-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" Condition="Exists('README.md')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit" Version="[8.3.0,9.0.0)" />
    <PackageReference Include="MassTransit.Azure.ServiceBus.Core" Version="[8.3.0,9.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="[10.0.0,11.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.0.0,11.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mpt.Framework.MessageHub.Abstractions\Mpt.Framework.MessageHub.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mpt.Framework.MessageHub.Tests" />
    <!-- Castle DynamicProxy (used by NSubstitute) needs visibility to proxy internal interfaces in tests. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
